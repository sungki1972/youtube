# Supabase 설정 (선택사항 - 자동 DB 저장용)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# 서버 설정
PORT=9897
NODE_ENV=development

# (FTP 사용 안 함) FTP 관련 설정 제거됨

# 기타 설정
MAX_FILE_SIZE=100MB
UPLOAD_PATH=./uploads

# AI API 설정 (Grok API 사용)
AI_API_KEY=your-grok-api-key
# 권장 모델 (요약/번역 작업, 비용/속도 최적):
#   grok-4-1-fast-non-reasoning    (2025-11, 권장 디폴트)
#   grok-4-fast-non-reasoning      (2025-09, 안정적)
#   grok-4.20-0309-non-reasoning   (2026-03, 최신)
#   grok-3, grok-3-mini            (구버전, 폴백용)
AI_MODEL=grok-4-1-fast-non-reasoning
AI_API_BASE_URL=https://api.x.ai/v1

# 음성인식용 OpenAI API (Whisper 전용)
OPENAI_API_KEY=your-openai-api-key

# Telegram 완료 알림 (선택사항; 둘 다 설정되어야 동작)
# 봇 토큰: @BotFather에서 발급
# 채팅 ID: 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 알림 메시지의 다운로드 링크에 사용할 공인 베이스 URL (외부 접속 가능한 주소)
PUBLIC_BASE_URL=http://112.223.44.142:9897

# Google Translate (선택사항)
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json

# YouTube 자동 업로드 (선택사항; 3개 모두 설정되어야 동작, 미설정 시 조용히 스킵)
# 1) Google Cloud Console에서 OAuth 2.0 클라이언트 ID(데스크톱 앱) 생성 → CLIENT_ID/SECRET 획득
# 2) YouTube Data API v3 활성화
# 3) node scripts/get-youtube-token.js 실행 → 브라우저 동의 후 콘솔에 출력되는 REFRESH_TOKEN 복사
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# 업로드 공개 범위: unlisted(기본, 링크공개) | private | public
YOUTUBE_PRIVACY_STATUS=unlisted

# Grok API 설정 (프롬프트 기능용 - 필수)
# Grok API 키를 설정하면 실제 AI 분석 결과를 받을 수 있습니다.
# 설정하지 않으면 템플릿만 저장됩니다.

# Enterprise Stability 설정 (모두 선택사항, 기본값 있음)
LOG_LEVEL=info                          # error, warn, info, debug
FFMPEG_TIMEOUT=600000                   # FFmpeg 타임아웃 (ms, 기본 10분)
YTDLP_TIMEOUT=1800000                   # yt-dlp 타임아웃 (ms, 기본 30분)
SSE_TIMEOUT=600000                      # SSE 연결 타임아웃 (ms, 기본 10분)
AI_API_TIMEOUT=120000                   # AI API 타임아웃 (ms, 기본 2분)
SSE_HEARTBEAT_INTERVAL=30000            # SSE heartbeat 간격 (ms, 기본 30초)
MAX_CONCURRENT_JOBS=2                   # 동시 MP3 추출 작업 수
MAX_CONCURRENT_SIEUN=2                  # 동시 시은이 작업 수
MAX_JOBS=100                            # 작업 큐 최대 크기
MAX_SSE_PER_JOB=5                       # job당 최대 SSE 연결 수
JOB_CLEANUP_DELAY=300000                # 완료 작업 정리 지연 (ms, 기본 5분)

# 주의사항:
# - Supabase 설정이 없으면 로컬 파일만 생성됩니다
# - FTP 설정이 없으면 로컬 저장만 됩니다
# - AI API 설정이 없으면 더미 데이터로 테스트됩니다
# - 모든 설정이 선택사항이며, 기본 기능은 YouTube -> 로컬 MP3입니다

# 시은이 기능 사용을 위한 Supabase 테이블 생성 SQL:
# CREATE TABLE sieun_history (
#     id SERIAL PRIMARY KEY,
#     original_filename VARCHAR(255) NOT NULL,
#     english_text TEXT NOT NULL,
#     korean_text TEXT NOT NULL,
#     mp3_file_path VARCHAR(500),
#     created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
# );





